{
  "expo": {
    "name": "Nano Agents",
    "slug": "nano-agents",
    "scheme": "nano-agents",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nanoagents.app"
    },
    "android": {
      "package": "com.nanoagents.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
