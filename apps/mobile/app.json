{
  "expo": {
    "name": "Nano Agents",
    "slug": "nano-agents",
    "scheme": "nano-agents",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "eas": {
      "projectId": "47834947-adeb-4aa2-b980-bc72ac43be47"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nanoagents.app"
    },
    "android": {
      "package": "com.nanoagents.app",
      "softwareKeyboardLayoutMode": "pan",
      "usesCleartextTraffic": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "nano-agents" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-sharing",
      "expo-video",
      ["expo-notifications", { "defaultChannel": "default" }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nano Agents to attach photos to messages.",
          "cameraPermission": "Allow Nano Agents to take photos for messages."
        }
      ]
    ]
  }
}
